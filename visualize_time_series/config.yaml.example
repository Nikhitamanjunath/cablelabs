# Visualize Time Series Configuration

# Path to analyze_time_series output folder (contains forecasts, metrics, decomposition)
analysis_output_folder: "data/analyze_time_series"

# Optional: path to transformed data for full actuals time series (all dates)
# If not set, actuals are shown only for test dates from the forecasts file
transformed_data_file: "data/transformed/transformed_data.parquet"

# Forecasts and metrics filenames (relative to analysis_output_folder)
forecasts_file: "forecasts.parquet"
metrics_file: "metrics.json"
decomposition_file: "decomposition.parquet"

# Port and host for the Dash web server (use a different port than task visualize, which uses 8050)
port: 8051
host: "127.0.0.1"
