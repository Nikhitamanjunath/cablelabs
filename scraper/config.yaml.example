specmon:
  url: "https://specmon.cablelabs.com/home"
  credentials:
    username: "your_username"
    password: "your_password"
  location: "CableLabs, Louisville"
  graph_parameters:
    from_date: "2024-01-01"
    to_date: "2024-01-31"
    start_freq: "3550"
    end_freq: "3700"
    power_threshold: "-72 dBm/20MHz (Wi-Fi PD)"
    graph_type: "Airtime Utilization"
  options:
    remember_me: false
    headless: true
