# Visualize Configuration (single config, multiple profiles)
# Copy to config.yaml. Use --profile <name> to select profile (default: main).

port: 8050
host: "127.0.0.1"
default_profile: main

# Named profiles: each has prediction_data_file and optional winner_mode (Predicted/Actual/Error only).
# task visualize          -> profile main
# task visualize-blend    -> profile blend
# task visualize-persistence-delta -> profile persistence_delta
profiles:
  main:
    prediction_data_file: "data/predictions/predictions_data.parquet"
    winner_mode: false
  blend:
    prediction_data_file: "data/predictions_blend/predictions.parquet"
    winner_mode: true
  persistence_delta:
    prediction_data_file: "data/predictions_persistence_delta/predictions.parquet"
    winner_mode: true
